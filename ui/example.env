# Copy to ui/.env for local development. Vite reads VITE_* at dev/build time;
# BACKEND_URL is read at container start by the nginx entrypoint (ui/Dockerfile).

# ── Local development / build time (VITE_*, baked into the bundle) ──────────

# Where the /admin API lives. Empty = same origin as the page. Leave it empty:
# `pnpm dev` proxies /admin to http://localhost:8080 (vite.config.ts), and the
# Docker image proxies /admin via nginx. Only set this when serving the static
# build with no proxy in front (e.g. `pnpm preview` against a remote backend).
VITE_API_BASE_URL=

# Base URL of the Langfuse UI, e.g. https://langfuse-sciedu.sdc.nycu.club
# When unset, every "open in Langfuse" link is hidden (session ids stay
# copyable). Build-time only — pass as a --build-arg for the Docker image.
VITE_LANGFUSE_URL=

# ── Container runtime (read when the ui image starts) ───────────────────────

# The backend the container proxies /admin/* to. Scheme + host + port only —
# no trailing slash, no path. In a compose deployment this is the backend
# service name, e.g. http://llm-provider:8080.
BACKEND_URL=http://localhost:8080
