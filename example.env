# =============================================================================
# REQUIRED — the app does not run without these.
# =============================================================================

# OpenAI-compatible server
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Comma-separated list of model ids the /chat endpoint may serve. The app
# refuses to start when this is empty; requests for a model outside the list are
# rejected with a 400.
ALLOWED_MODELS=gpt-oss-120b

# Langfuse. The service reads its prompts, presets and corpus from this project
# and writes every trace to it.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=


# =============================================================================
# OPTIONAL — every variable below has the default shown in its comment.
# =============================================================================

# --- Models ------------------------------------------------------------------
# Model used by /chat and /agents when neither the request nor the preset names
# one. Must itself be in ALLOWED_MODELS. (default: gpt-oss-120b)
OPENAI_DEFAULT_MODEL=gpt-oss-120b

# --- Langfuse ----------------------------------------------------------------
# Environment tag attached to every trace, for filtering in the Langfuse UI.
# (default: default)
LANGFUSE_TRACING_ENVIRONMENT=local
# Batching: how many observations buffer before a flush, and how often the
# buffer is flushed regardless, in seconds. (defaults: 200, 5)
LANGFUSE_FLUSH_AT=200
LANGFUSE_FLUSH_INTERVAL=5

# --- RAG ---------------------------------------------------------------------
# Comma-separated Langfuse corpus dataset names to index at startup. Optional:
# when empty, every dataset under CORPUS_DATASET_FOLDER is discovered from
# Langfuse and indexed instead, so seeding a corpus is enough to get retrieval.
# Set it to pin an explicit subset. RAG is disabled only when neither yields a
# dataset — /chat then answers `enable_rag: true` with a 503, and any preset
# granting `rag_search` is rejected with a 503. (default: empty)
RAG_CORPUS_DATASETS=
# Embedding and reranking models, served by OPENAI_BASE_URL.
# (defaults: bge-m3, BGE-Reranker-V2-M3)
RAG_EMBEDDING_MODEL=bge-m3
RAG_RERANK_MODEL=BGE-Reranker-V2-M3
# Indexing throughput. (defaults: 64, 64)
RAG_EMBEDDING_BATCH_SIZE=64
RAG_MAX_CONCURRENCY=64
# Chunking, in characters. (defaults: 500, 100)
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
# Langfuse prompts used to build the grounded answer for a `rag_mode: "forced"`
# preset. (defaults: rag-generator-system, rag-generator-user)
RAG_GENERATOR_SYSTEM_PROMPT_NAME=rag-generator-system
RAG_GENERATOR_USER_PROMPT_NAME=rag-generator-user
# Retrieval knobs — initial values only; overridable at runtime via /admin/rag.
# (defaults: 50, 50, 60, 30, 5)
RAG_BM25_TOP_N=50
RAG_DENSE_TOP_N=50
RAG_RRF_K=60
RAG_RERANK_POOL_SIZE=30
RAG_FINAL_K=5

# --- Agents / presets --------------------------------------------------------
# How long a single tool may stall before it is reported to the model as a
# timeout. (default: 60)
AGENTS_TOOL_TIMEOUT_SECONDS=60

# Langfuse dataset holding the preset documents, one preset per item `input`.
# The presets this server ships with (default-agents, default-chat,
# default-chat-plain) are written into this dataset at startup if it does not
# already hold them; existing items are never overwritten. A dataset entry
# always wins over the shipped default of the same name, which is how a preset
# is tuned without a release — and deleting that entry restores the shipped
# default. A missing or unreachable dataset is survivable: the shipped defaults
# are served from code. (default: config/presets)
PRESETS_DATASET_NAME=config/presets
# How long a loaded preset map is served before the dataset is re-read.
# (default: 300)
PRESETS_CACHE_TTL_SECONDS=300
# The preset /agents runs when the request omits `preset`.
# (default: default-agents)
AGENTS_DEFAULT_PRESET=default-agents
# The presets /chat is implemented on top of; `enable_rag` picks between them.
# (defaults: default-chat-plain, default-chat)
CHAT_PRESET_NAME=default-chat-plain
CHAT_RAG_PRESET_NAME=default-chat

# --- Judge -------------------------------------------------------------------
# Langfuse folder the judge prompts live under, and the prompt that turns a
# judgement into a score. (defaults: judge, extract-score-from-judgement)
JUDGE_PROMPT_FOLDER=judge
JUDGE_EXTRACT_PROMPT_NAME=extract-score-from-judgement
# How many times score extraction is retried, and the score recorded when it
# still fails. (defaults: 10, -1.0)
JUDGE_MAX_EXTRACT_RETRIES=10
JUDGE_FAILED_SCORE=-1.0

# --- Admin listings ----------------------------------------------------------
# Langfuse dataset folder prefixes the /admin listing endpoints group datasets
# by — "corpus/ver3/biology" is a corpus dataset, "questions/biology" a question
# dataset. CORPUS_DATASET_FOLDER is also what RAG corpus auto-discovery scans.
# Set these only if your Langfuse project uses a different naming convention.
# (defaults: corpus, questions)
CORPUS_DATASET_FOLDER=corpus
QUESTIONS_DATASET_FOLDER=questions

# How far back GET /admin/evals/history looks. Langfuse v4 keeps judge runs as
# experiments and its listing endpoint requires a start time, so history is
# always a window rather than everything ever recorded. (default: 90)
EVALS_HISTORY_LOOKBACK_DAYS=90

# --- Logging -----------------------------------------------------------------
# Root log level. INFO is what makes a long index rebuild watchable: the corpus
# datasets as they are collected, embedding progress every few seconds, and the
# totals when it lands. Drop to WARNING for a quiet log. (default: INFO)
LOG_LEVEL=INFO
